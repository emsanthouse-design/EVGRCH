VITE_SUPABASE_URL=https://lnkxcigvjufszghqjfvw.supabase.co
VITE_SUPABASE_ANON_KEY=

# Functions only (never shipped to the browser)
SUPABASE_URL=https://lnkxcigvjufszghqjfvw.supabase.co
SUPABASE_ADMIN_KEY=
INTERNAL_SECRET=            # random string; lets refresh/weekly functions call the background collector
DATAFORSEO_LOGIN=           # DataForSEO API login (email)
DATAFORSEO_PASSWORD=        # DataForSEO API password (from their dashboard, not the account password)
GOOGLE_MAPS_API_KEY=        # Google Cloud key with Places API (New) enabled
PAGESPEED_API_KEY=          # optional; falls back to GOOGLE_MAPS_API_KEY if PageSpeed is enabled on it
